{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblevan.local/h3/character.schema.json",
  "title": "H3 character manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "references", "identity", "background_policy"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "references": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "file", "role", "picture_label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "file": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "picture_label": {"type": "string", "pattern": "^Picture [1-9]$"},
          "description": {"type": "string"}
        }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["gender", "style", "invariant_features"],
      "properties": {
        "gender": {"type": "string"},
        "style": {"type": "string"},
        "invariant_features": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "background_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {"type": {"type": "string"}, "description": {"type": "string"}}
    }
  }
}
