{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblevan.local/h3/shot.schema.json",
  "title": "H3 shot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "character", "references", "duration", "camera", "audio", "generation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "character": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "string"}},
    "reference_mode": {"type": "string", "enum": ["free", "reference_generation", "first_frame", "last_frame", "keyframe", "storyboard"]},
    "duration": {"type": "number", "minimum": 4, "maximum": 15},
    "action": {"type": "object", "additionalProperties": false, "required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}}},
    "opening": {"type": "object", "additionalProperties": false, "properties": {"framing": {"type": "string"}, "view": {"type": "string"}, "description": {"type": "string"}}},
    "beats": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "description"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "description": {"type": "string", "minLength": 1}}}},
    "ending": {"type": "object", "additionalProperties": false, "properties": {"description": {"type": "string"}}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "camera": {"type": "object", "additionalProperties": false, "required": ["type", "amplitude", "speed"], "properties": {"framing": {"type": "string"}, "type": {"type": "string"}, "amplitude": {"type": "string"}, "speed": {"type": "string"}}},
    "audio": {"type": "object", "additionalProperties": false, "required": ["policy"], "properties": {"policy": {"type": "string"}}},
    "generation": {
      "type": "object", "additionalProperties": false, "required": ["explore", "keep"],
      "properties": {"explore": {"$ref": "#/$defs/profile"}, "keep": {"$ref": "#/$defs/profile"}}
    }
  },
  "anyOf": [{"required": ["action"]}, {"required": ["beats"]}],
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["megapixels", "steps", "turbo", "takes"],
      "properties": {
        "megapixels": {"type": "number", "minimum": 0.1, "maximum": 2},
        "steps": {"type": "integer", "minimum": 1, "maximum": 100},
        "turbo": {"type": "boolean"},
        "takes": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
