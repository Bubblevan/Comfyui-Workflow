{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblevan.local/h3/shot.schema.json",
  "title": "H3 shot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "character", "references", "duration", "camera", "audio", "generation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "character": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "string"}},
    "reference_mode": {"type": "string", "enum": ["free", "reference_generation", "first_frame", "last_frame", "keyframe", "storyboard"]},
    "duration": {"type": "number", "minimum": 4, "maximum": 15},
    "action": {"type": "object", "additionalProperties": false, "required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}}},
    "opening": {"type": "object", "additionalProperties": false, "properties": {"framing": {"type": "string"}, "view": {"type": "string"}, "description": {"type": "string"}}},
    "beats": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "description"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "description": {"type": "string", "minLength": 1}}}},
    "ending": {"type": "object", "additionalProperties": false, "properties": {"description": {"type": "string"}}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "camera": {"type": "object", "additionalProperties": false, "required": ["type", "amplitude", "speed"], "properties": {"framing": {"type": "string"}, "type": {"type": "string"}, "amplitude": {"type": "string"}, "speed": {"type": "string"}}},
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": {
        "policy": {"type": "string", "enum": ["silent", "dialogue", "soundscape"]},
        "language": {"type": "string"},
        "voice": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "gender": {"type": "string"},
            "age": {"type": "string"},
            "style": {"type": "string"}
          }
        },
        "dialogue": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["start", "end", "speaker", "text"],
            "properties": {
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "speaker": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "delivery": {"type": "string"}
            }
          }
        },
        "ambience": {"type": "string"},
        "music": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ref_image_size": {"type": "string", "enum": ["max", "match", "min"], "default": "match"},
        "sampler": {"type": "string", "minLength": 1, "default": "euler"},
        "scheduler": {"type": "string", "minLength": 1, "default": "simple"},
        "model_shift": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "shift_video": {"type": "number", "default": 12},
            "shift_audio": {"type": "number", "default": 3}
          }
        },
        "attention": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "backend": {"type": "string", "enum": ["default", "kitchen", "sage"], "default": "kitchen"},
            "sage_attention": {
              "type": "string",
              "enum": [
                "auto",
                "sageattn_qk_int8_pv_fp16_cuda",
                "sageattn_qk_int8_pv_fp16_triton",
                "sageattn_qk_int8_pv_fp8_cuda",
                "sageattn_qk_int8_pv_fp8_cuda++"
              ],
              "default": "auto"
            },
            "allow_compile": {"type": "boolean", "default": false}
          }
        },
        "cache": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "profile": {"type": "string", "enum": ["Balanced", "Fast", "Quality"]},
            "video_threshold": {"type": "number", "minimum": 0},
            "audio_threshold": {"type": "number", "minimum": 0},
            "start_percent": {"type": "number", "minimum": 0, "maximum": 1},
            "end_percent": {"type": "number", "minimum": 0, "maximum": 1},
            "warmup_steps": {"type": "integer", "minimum": 0},
            "max_steps": {"type": "integer", "minimum": 1},
            "video_metric_stride": {"type": "integer", "minimum": 1},
            "audio_metric_stride": {"type": "integer", "minimum": 1},
            "device": {"type": "string"},
            "verbose": {"type": "boolean"}
          }
        },
        "approximation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "enum": ["none", "teacache", "spectrum", "speed_cache", "fastpath"], "default": "none"},
            "teacache": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "rel_l1_thresh": {"type": "number", "minimum": 0, "maximum": 0.5},
                "start_step": {"type": "integer", "minimum": 0},
                "end_step": {"type": "integer", "minimum": -20},
                "total_steps": {"type": "integer", "minimum": 1}
              }
            },
            "spectrum": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "blend_weight": {"type": "number", "minimum": 0, "maximum": 1},
                "audio_blend_weight": {"type": "number", "minimum": 0, "maximum": 1},
                "degree": {"type": "integer", "minimum": 1, "maximum": 16},
                "ridge_lambda": {"type": "number", "minimum": 0},
                "window_size": {"type": "number", "minimum": 1},
                "flex_window": {"type": "number", "minimum": 0},
                "warmup_steps": {"type": "integer", "minimum": 0},
                "tail_actual_steps": {"type": "integer", "minimum": 0},
                "max_history": {"type": "integer", "minimum": 2},
                "history_storage": {"type": "string", "enum": ["system_ram", "vram"]},
                "bootstrap_first_forecast": {"type": "boolean"},
                "anchor_residual_feedback": {"type": "boolean"},
                "selective_rollback_correction": {"type": "boolean"},
                "offline_smoothing_replay": {"type": "boolean"},
                "offline_archive_storage": {"type": "string", "enum": ["system_ram", "vram"]},
                "model_aware_mode": {"type": "string", "enum": ["off", "schedule", "schedule_confidence", "full"]},
                "model_aware_risk_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                "model_aware_trust_shrinkage": {"type": "boolean"},
                "model_aware_replay_generic_correction": {"type": "boolean"},
                "generic_correction_mode": {"type": "string", "enum": ["legacy", "coordinate_rls", "coordinate_rls_reliability", "regional"]},
                "generic_correction_limiter": {"type": "string", "enum": ["rational", "hard_clip", "tanh"]},
                "generic_correction_limit": {"type": "number", "minimum": 0.01, "maximum": 1},
                "generic_correction_attenuation": {"type": "string", "enum": ["mode_default", "no_attenuation", "general_confidence", "correction_reliability", "combined_conservative"]},
                "sa_pece_forecast_policy": {"type": "string", "enum": ["max_speed", "balanced", "stable_start"]},
                "debug": {"type": "boolean"}
              }
            },
            "speed_cache": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "reuse_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                "start_percent": {"type": "number", "minimum": 0, "maximum": 1},
                "end_percent": {"type": "number", "minimum": 0, "maximum": 1},
                "max_consecutive_skips": {"type": "integer", "minimum": 1, "maximum": 5},
                "cache_device": {"type": "string", "enum": ["auto", "gpu", "cpu"]},
                "vram_reserve_gb": {"type": "number", "minimum": 0.5},
                "ram_reserve_gb": {"type": "number", "minimum": 1},
                "signature_tokens": {"type": "integer", "minimum": 32},
                "signature_features": {"type": "integer", "minimum": 16},
                "verbose": {"type": "boolean"},
                "sage_attention": {"type": "string", "enum": ["auto", "enabled", "disabled"]}
              }
            },
            "fastpath": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "prefix_blocks": {"type": "integer", "minimum": 1},
                "suffix_blocks": {"type": "integer", "minimum": 1},
                "reuse_threshold": {"type": "number", "minimum": 0, "maximum": 2},
                "max_consecutive_reuses": {"type": "integer", "minimum": 1, "maximum": 4},
                "cache_device": {"type": "string", "enum": ["gpu", "cpu"]},
                "require_fastpath_schedule": {"type": "boolean"},
                "strict_branch_identity": {"type": "boolean"},
                "suppress_candidate_prefetch": {"type": "boolean"},
                "verbose": {"type": "boolean"}
              }
            }
          }
        },
        "models": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "transformer": {"type": "string", "minLength": 1},
            "text_encoder": {"type": "string", "minLength": 1},
            "turbo_lora": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false, "required": ["explore", "keep"],
      "properties": {"explore": {"$ref": "#/$defs/profile"}, "keep": {"$ref": "#/$defs/profile"}}
    }
  },
  "anyOf": [{"required": ["action"]}, {"required": ["beats"]}],
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["megapixels", "steps", "turbo", "takes"],
      "properties": {
        "megapixels": {"type": "number", "minimum": 0.1, "maximum": 2},
        "steps": {"type": "integer", "minimum": 1, "maximum": 100},
        "turbo": {"type": "boolean"},
        "takes": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
