{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblevan.local/h3/nsfw-atom-registry.schema.json",
  "title": "H3 NSFW compositional atom registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "policy", "dimension_order", "definitions", "composition"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adult_only", "fictional_only", "consent_required", "source_strings_are_evidence_not_approval", "prohibited_contexts"],
      "properties": {
        "adult_only": {"type": "boolean", "const": true},
        "fictional_only": {"type": "boolean", "const": true},
        "consent_required": {"type": "boolean", "const": true},
        "source_strings_are_evidence_not_approval": {"type": "boolean", "const": true},
        "prohibited_contexts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dimension_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "separation_rules": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "title", "h3_phrase", "requires", "excludes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "dimension": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "h3_phrase": {"type": "string", "minLength": 1},
          "requires": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "excludes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_atoms", "max_atoms_per_shot", "one_of_dimensions", "repeatable_dimensions", "examples", "transition_exceptions", "conflict_rules", "visibility_rules"],
      "properties": {
        "default_atoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "max_atoms_per_shot": {"type": "integer", "minimum": 1},
        "one_of_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "repeatable_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source_recipe", "atoms", "temporal_notes"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source_recipe": {"type": "string", "minLength": 1},
              "atoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "temporal_notes": {"type": "string", "minLength": 1}
            }
          }
        },
        "transition_exceptions": {
          "type": "array",
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
        },
        "conflict_rules": {
          "type": "array",
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
        },
        "visibility_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["if", "require_any"],
            "properties": {
              "if": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "require_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
