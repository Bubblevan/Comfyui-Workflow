{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblevan.local/h3/nsfw-entry.schema.json",
  "title": "Local H3 NSFW prompt card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "category",
    "tags",
    "safety",
    "prompt",
    "compatibility",
    "provenance",
    "review"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["effect", "pose", "camera", "motion"]},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adult_only", "fictional_only", "consent_model", "prohibited_contexts"],
      "properties": {
        "adult_only": {"type": "boolean", "const": true},
        "fictional_only": {"type": "boolean", "const": true},
        "consent_model": {"type": "string", "const": "explicit_roleplay"},
        "prohibited_contexts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "beats", "ending", "constraints"],
      "properties": {
        "opening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framing", "view", "description"],
          "properties": {
            "framing": {"type": "string", "minLength": 1},
            "view": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "description"],
            "properties": {
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "ending": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family", "reference_mode", "recommended_duration", "sampler", "scheduler"],
      "properties": {
        "model_family": {"type": "string", "minLength": 1},
        "reference_mode": {"type": "string", "enum": ["free", "reference_generation", "first_frame", "last_frame", "keyframe", "storyboard"]},
        "recommended_duration": {"type": "number", "minimum": 4, "maximum": 15},
        "recommended_references": {"type": "array", "items": {"type": "string"}},
        "sampler": {"type": "string", "minLength": 1},
        "scheduler": {"type": "string", "minLength": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ids", "license_status"],
      "properties": {
        "source_type": {"type": "string", "enum": ["original_local", "adapted_from_research", "imported_with_metadata"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "license_status": {"type": "string", "enum": ["local_original", "reference_only_verify_before_use", "verified_for_local_use"]},
        "notes": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "last_reviewed"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "reviewed", "approved", "retired"]},
        "reviewer": {"type": "string", "minLength": 1},
        "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "known_issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
